<Window x:Class="WaveFix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaveFix" Width="1140" Height="720" MinWidth="960" MinHeight="600"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22,18,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,28">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource Primary}">
                        <TextBlock Text="&#xE720;" Style="{StaticResource Icon}" FontSize="19" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WaveFix" FontSize="18" FontWeight="ExtraBold"/>
                        <TextBlock Text="Clean mic, no leaks" FontSize="12" Foreground="{StaticResource SubText}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <!-- Update available -->
                    <Border x:Name="UpdateCard" CornerRadius="14" Padding="14" Margin="0,0,0,12" Background="{StaticResource PrimarySoft}"
                            BorderBrush="{StaticResource Primary}" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Foreground="#C7D2FE" Margin="0,0,8,0"/>
                                <TextBlock x:Name="UpdateTitle" Text="Update available" FontWeight="Bold" FontSize="13.5"/>
                            </StackPanel>
                            <TextBlock x:Name="UpdateText" Style="{StaticResource Hint}" Foreground="#C7D2FE" Margin="0,0,0,10"/>
                            <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Height="36" Click="UpdateNow_Click"
                                    AutomationProperties.Name="Install the update now">
                                <TextBlock x:Name="UpdateButtonText" Text="Update now" FontWeight="Bold" FontSize="13" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border x:Name="StatusPill" CornerRadius="12" Padding="12,10" Background="{StaticResource GoodSoft}" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Good}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusPillText" Text="All good" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0" TextWrapping="Wrap" MaxWidth="160"/>
                        </StackPanel>
                    </Border>
                    <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Checked="StartupSwitch_Changed" Unchecked="StartupSwitch_Changed"
                              AutomationProperties.Name="Start WaveFix with Windows" Margin="4,0,0,0">
                        <TextBlock Text="Start with Windows" FontSize="13" Foreground="{StaticResource SubText}"/>
                    </CheckBox>
                    <CheckBox x:Name="AutoUpdateSwitch" Style="{StaticResource Switch}" Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed"
                              AutomationProperties.Name="Install updates automatically" Margin="4,10,0,0">
                        <TextBlock Text="Auto-update" FontSize="13" Foreground="{StaticResource SubText}"/>
                    </CheckBox>
                    <Button Style="{StaticResource LinkButton}" Margin="4,12,0,0" HorizontalAlignment="Left" Click="CheckUpdates_Click"
                            AutomationProperties.Name="Check for updates">
                        <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource SubText}"/>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavSetup" Style="{StaticResource NavItem}" GroupName="nav" Content="Setup" Tag="&#xE713;" Checked="Nav_Checked" Visibility="Collapsed"/>
                    <RadioButton x:Name="NavMic" Style="{StaticResource NavItem}" GroupName="nav" Content="Microphone" Tag="&#xE720;" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavVoice" Style="{StaticResource NavItem}" GroupName="nav" Content="Voice changer" Tag="&#xE8D6;" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSoundboard" Style="{StaticResource NavItem}" GroupName="nav" Content="Soundboard" Tag="&#xE7F6;" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavMixer" Style="{StaticResource NavItem}" GroupName="nav" Content="App mixer" Tag="&#xE767;" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPlugins" Style="{StaticResource NavItem}" GroupName="nav" Content="Plugins" Tag="&#xEA86;" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavShortcuts" Style="{StaticResource NavItem}" GroupName="nav" Content="Shortcuts" Tag="&#xE765;" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Pages ============ -->
        <Grid Grid.Column="1">

            <!-- ===== Setup ===== -->
            <ScrollViewer x:Name="PageSetup" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,26,32,26">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Let's set up your mic" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="WaveFix can install and connect everything for you. It takes about a minute." Style="{StaticResource PageSubtitle}"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Which mic do you talk into?" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding Mic.Devices}" SelectedItem="{Binding Mic.Selected}" Margin="0,0,0,6" AutomationProperties.Name="Microphone to set up"/>
                            <TextBlock Text="Pick your real microphone, not anything called &quot;Elgato Virtual Audio&quot;." Style="{StaticResource Hint}" Margin="0,0,0,20"/>

                            <ItemsControl x:Name="SetupSteps">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#25253D" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{Binding Color}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Label}"/>
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border x:Name="SetupResult" CornerRadius="12" Padding="14,12" Margin="0,4,0,16" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="SetupResultText" Style="{StaticResource Hint}" Foreground="{StaticResource Text}" FontSize="13"/>
                                    <WrapPanel x:Name="SetupHelp" Margin="0,10,0,0" Visibility="Collapsed">
                                        <Button x:Name="PickPluginButton" Style="{StaticResource SoftButton}" Height="36" Padding="12,0" Margin="0,0,8,6" Click="PickPlugin_Click"
                                                AutomationProperties.Name="Use a plugin file I downloaded">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                                <TextBlock Text="Use a file I downloaded…" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="OpenPluginPageButton" Style="{StaticResource SoftButton}" Height="36" Padding="12,0" Margin="0,0,8,6" Click="OpenPluginPage_Click"
                                                AutomationProperties.Name="Open the plugin download page">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                                <TextBlock Text="Open the download page" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SoftButton}" Height="36" Padding="12,0" Margin="0,0,8,6" Click="CopySetupLog_Click"
                                                AutomationProperties.Name="Copy setup details">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="CopyLogText" Text="Copy details" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SetupButton" Style="{StaticResource PrimaryButton}" Height="48" Padding="22,0" Click="RunSetup_Click"
                                        AutomationProperties.Name="Run setup">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="SetupButtonText" Text="Set it up for me" FontWeight="Bold" FontSize="14.5" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="UndoSetupButton" Style="{StaticResource LinkButton}" Margin="16,0,0,0" VerticalAlignment="Center" Click="UndoSetup_Click"
                                        Visibility="Collapsed" AutomationProperties.Name="Take WaveFix's engine off this mic"
                                        ToolTip="Puts this mic's original Windows effect settings back (one permission prompt).">
                                    <TextBlock Text="Take the engine off this mic" FontSize="12.5" Foreground="{StaticResource SubText}"/>
                                </Button>
                                <Button Style="{StaticResource LinkButton}" Margin="16,0,0,0" VerticalAlignment="Center" Click="CopyDiagnostics_Click"
                                        AutomationProperties.Name="Copy details for help"
                                        ToolTip="Copies what WaveFix and Windows report about your mic and the engine, to paste when asking for help.">
                                    <TextBlock Text="Copy details for help" FontSize="12.5" Foreground="{StaticResource SubText}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Background="#16162B" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="#A5B4FC" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock x:Name="SetupNote" Grid.Column="1" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="Windows will ask for permission once. Your sound drops for a few seconds at the end while Windows audio restarts."/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Microphone ===== -->
            <ScrollViewer x:Name="PageMic" VerticalScrollBarVisibility="Auto" Padding="32,26,32,26">
                <StackPanel>
                    <TextBlock Text="Your microphone" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Sound clean and clear everywhere, without your mic leaking into Discord streams." Style="{StaticResource PageSubtitle}"/>

                    <!-- Friendly status banner -->
                    <Border x:Name="Banner" CornerRadius="14" Padding="16,14" Margin="0,0,0,20" Background="{StaticResource GoodSoft}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BannerAction" Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="40" Padding="16,0" Margin="14,0,0,0"
                                    VerticalAlignment="Center" Click="OpenSetup_Click" Visibility="Collapsed" AutomationProperties.Name="Set it up for me">
                                <TextBlock Text="Set it up for me" FontWeight="Bold" FontSize="13.5" Foreground="White"/>
                            </Button>
                            <Border x:Name="BannerIconBg" Width="34" Height="34" CornerRadius="17" Background="{StaticResource Good}" VerticalAlignment="Top">
                                <TextBlock x:Name="BannerIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="15" Foreground="#0F0F23" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="BannerTitle" Text="You're all set" FontSize="15" FontWeight="Bold"/>
                                <TextBlock x:Name="BannerText" Style="{StaticResource Hint}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Level & volume -->
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Level &amp; volume" Style="{StaticResource CardTitle}" Margin="0,0,0,16"/>

                                <TextBlock Text="Microphone" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding Mic.Devices}" SelectedItem="{Binding Mic.Selected}" Margin="0,0,0,20"
                                          AutomationProperties.Name="Microphone"/>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="MeterHint" DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="Talk to see your level"/>
                                    <TextBlock Text="Live level" Style="{StaticResource Label}"/>
                                </DockPanel>
                                <Border Height="16" CornerRadius="8" Background="#25253D" ClipToBounds="True" Margin="0,0,0,22">
                                    <Grid x:Name="MeterHost">
                                        <Border x:Name="MeterFill" HorizontalAlignment="Left" CornerRadius="8" Width="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#22C55E" Offset="0"/>
                                                    <GradientStop Color="#22C55E" Offset="0.68"/>
                                                    <GradientStop Color="#F97316" Offset="0.86"/>
                                                    <GradientStop Color="#EF4444" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="{Binding Mic.Gain, StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Input level" Style="{StaticResource Label}"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="100" Value="{Binding Mic.Gain}" Margin="0,0,0,14" AutomationProperties.Name="Input level"/>

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock x:Name="BoostValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Mic boost" Style="{StaticResource Label}"/>
                                </DockPanel>
                                <Slider x:Name="BoostSlider" Minimum="-6" Maximum="24" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Boost_Changed"
                                        AutomationProperties.Name="Mic boost"/>
                                <TextBlock x:Name="BoostHint" Style="{StaticResource Hint}" Margin="0,4,0,22"
                                           Text="Need to be louder? Turn up the input level first, then add boost. If the meter turns red, back off a little."/>

                                <ToggleButton x:Name="MuteToggle" Style="{StaticResource MuteButton}" IsChecked="{Binding Mic.Muted}" Height="54"
                                              AutomationProperties.Name="Mute microphone">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MuteIcon" Text="&#xE720;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="MuteLabel" Text="Mic is on, click to mute" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </Border>

                        <!-- Sound cleanup -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Sound cleanup" Style="{StaticResource CardTitle}" Margin="0,0,0,16"/>

                                <CheckBox x:Name="NoiseSwitch" Style="{StaticResource Switch}" Click="NoiseSwitch_Click"
                                          AutomationProperties.Name="Noise removal" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Noise removal" Style="{StaticResource Label}"/>
                                        <TextBlock Text="Hides keyboard clicks, fans and room noise between your words." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Button Style="{StaticResource SoftButton}" Height="32" Padding="12,0" Click="NoiseSettings_Click"
                                            AutomationProperties.Name="Adjust noise removal">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Adjust" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="NoiseResetButton" Style="{StaticResource LinkButton}" Margin="12,0,0,0" VerticalAlignment="Center" Click="NoiseReset_Click"
                                            AutomationProperties.Name="Reset noise removal to defaults">
                                        <TextBlock Text="Reset to default" FontSize="12.5" Foreground="{StaticResource SubText}"/>
                                    </Button>
                                </StackPanel>

                                <CheckBox x:Name="LowCutSwitch" Style="{StaticResource Switch}" Click="LowCutSwitch_Click"
                                          AutomationProperties.Name="Low cut" Margin="0,0,0,22">
                                    <StackPanel>
                                        <TextBlock Text="Rumble filter" Style="{StaticResource Label}"/>
                                        <TextBlock Text="Cuts desk bumps and low hum (below 80 Hz)." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <TextBlock Text="Voice tone" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                                <WrapPanel x:Name="PresetPanel" Margin="0,0,0,10"/>
                                <StackPanel x:Name="CustomEqPanel" Visibility="Collapsed" Margin="0,4,0,6">
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="CustomEqReset_Click" AutomationProperties.Name="Reset custom tone">
                                            <TextBlock Text="Reset" FontSize="12.5" Foreground="{StaticResource SubText}"/>
                                        </Button>
                                        <TextBlock Text="Shape your own tone. Small moves (2 to 4 dB) go a long way." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <StackPanel x:Name="CustomEqBands"/>
                                </StackPanel>

                                <Border CornerRadius="12" Background="#16162B" Padding="14,12" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="#A5B4FC" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Hint}"
                                                   Text="All of this runs inside Windows' own audio engine, so Discord streams can't pick up your mic."/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Voice polish -->
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Voice polish" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Text="Studio tools that make you sound steady and pro. Like everything here, they run in Windows' audio engine." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,18">
                                    <CheckBox x:Name="LevelerSwitch" Style="{StaticResource Switch}" Click="Polish_Click" AutomationProperties.Name="Leveler">
                                        <StackPanel>
                                            <TextBlock Text="Leveler" Style="{StaticResource Label}"/>
                                            <TextBlock Text="Evens out loud and quiet moments so you're always easy to hear (a compressor)." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <DockPanel Margin="0,10,0,2">
                                        <TextBlock x:Name="LevelerValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Strength" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider x:Name="LevelerSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" ValueChanged="Polish_Changed" AutomationProperties.Name="Leveler strength"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,18">
                                    <CheckBox x:Name="DeEsserSwitch" Style="{StaticResource Switch}" Click="Polish_Click" AutomationProperties.Name="De-esser">
                                        <StackPanel>
                                            <TextBlock Text="De-esser" Style="{StaticResource Label}"/>
                                            <TextBlock Text="Softens sharp S and SH sounds without dulling your voice." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <DockPanel Margin="0,10,0,2">
                                        <TextBlock x:Name="DeEsserValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Strength" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider x:Name="DeEsserSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" ValueChanged="Polish_Changed" AutomationProperties.Name="De-esser strength"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,0,0">
                                    <CheckBox x:Name="SilencerSwitch" Style="{StaticResource Switch}" Click="Polish_Click" AutomationProperties.Name="Background silencer">
                                        <StackPanel>
                                            <TextBlock Text="Background silencer" Style="{StaticResource Label}"/>
                                            <TextBlock Text="Turns down quiet sounds while you aren't talking (an expander)." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <DockPanel Margin="0,10,0,2">
                                        <TextBlock x:Name="SilencerValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Sensitivity" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider x:Name="SilencerSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" ValueChanged="Polish_Changed" AutomationProperties.Name="Background silencer sensitivity"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,0">
                                    <CheckBox x:Name="LimiterSwitch" Style="{StaticResource Switch}" Click="Polish_Click" AutomationProperties.Name="Peak protection">
                                        <StackPanel>
                                            <TextBlock Text="Peak protection" Style="{StaticResource Label}"/>
                                            <TextBlock Text="Stops shouts and laughs from clipping. Runs last, after mic boost (a limiter)." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <DockPanel Margin="0,10,0,2">
                                        <TextBlock x:Name="LimiterValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Loudest allowed" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider x:Name="LimiterSlider" Minimum="-12" Maximum="0" TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="1" ValueChanged="Polish_Changed" AutomationProperties.Name="Peak protection loudest allowed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Voice changer ===== -->
            <ScrollViewer x:Name="PageVoice" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,26,32,26">
                <StackPanel>
                    <TextBlock Text="Voice changer" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Sound like someone (or something) else in Discord, games and every other app." Style="{StaticResource PageSubtitle}"/>

                    <Border x:Name="FxMissing" CornerRadius="12" Background="{StaticResource WarnSoft}" Padding="14,12" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource Text}" TextWrapping="Wrap"
                                   Text="This copy of WaveFix was built without its voice effects, so the voice changer and voice polish can't run. Install the latest release to get them."/>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <CheckBox x:Name="VoiceSwitch" Style="{StaticResource Switch}" Click="VoiceSwitch_Click" AutomationProperties.Name="Voice changer">
                            <StackPanel>
                                <TextBlock Text="Voice changer" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="VoiceStateText" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Voices" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                            <WrapPanel x:Name="VoicePresetPanel"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button x:Name="VoiceResetButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="VoiceReset_Click" AutomationProperties.Name="Reset the voice to its preset">
                                    <TextBlock Text="Back to preset" FontSize="12.5" Foreground="{StaticResource SubText}"/>
                                </Button>
                                <TextBlock Text="Fine tune" Style="{StaticResource CardTitle}"/>
                            </DockPanel>
                            <TextBlock Text="Moving a slider makes it your own Custom voice." Style="{StaticResource Hint}" Margin="0,0,0,16"/>
                            <Grid x:Name="VoiceSliders">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Background="#16162B" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="#A5B4FC" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="Like your other effects, the voice changer runs inside Windows' audio engine, so Discord streams still can't pick up your mic. Changing pitch adds a small delay (about 40 ms). Set a shortcut to switch voices mid-game."/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Soundboard ===== -->
            <ScrollViewer x:Name="PageSoundboard" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,26,32,26"
                          AllowDrop="True" DragOver="Soundboard_DragOver" Drop="Soundboard_Drop">
                <StackPanel>
                    <TextBlock Text="Soundboard" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Play sound effects into your mic. Everyone in Discord, games and calls hears them." Style="{StaticResource PageSubtitle}"/>

                    <Border x:Name="SoundboardNotice" CornerRadius="12" Background="{StaticResource WarnSoft}" Padding="14,12" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock x:Name="SoundboardNoticeText" Style="{StaticResource Hint}" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <CheckBox x:Name="SoundboardSwitch" Style="{StaticResource Switch}" Click="SoundboardSwitch_Click" AutomationProperties.Name="Soundboard">
                                <StackPanel>
                                    <TextBlock Text="Soundboard" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock x:Name="SoundboardStateText" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock x:Name="SoundVolumeValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Volume for everyone else" Style="{StaticResource Label}"/>
                                    </DockPanel>
                                    <Slider x:Name="SoundVolumeSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" ValueChanged="SoundVolume_Changed" AutomationProperties.Name="Soundboard volume for everyone else"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <CheckBox x:Name="HearMyselfSwitch" Style="{StaticResource Switch}" Click="HearMyself_Click" AutomationProperties.Name="Hear sounds myself">
                                        <TextBlock Text="Hear sounds myself" Style="{StaticResource Label}"/>
                                    </CheckBox>
                                    <Slider x:Name="MyVolumeSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" Margin="0,8,0,0" ValueChanged="SoundVolume_Changed" AutomationProperties.Name="Soundboard volume for me"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource SoftButton}" Height="38" Padding="14,0" Margin="0,0,8,0" Click="StopSounds_Click" AutomationProperties.Name="Stop all sounds">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Stop all" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AddSoundsButton" Style="{StaticResource PrimaryButton}" Height="38" Padding="16,0" Click="AddSounds_Click" AutomationProperties.Name="Add sounds">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="Add sounds" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Sounds" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock x:Name="EmptySounds" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,8"
                                       Text="No sounds yet. Click Add sounds or drop files here: MP3, WAV, M4A, WMA, AAC or FLAC, up to 15 minutes each. Click a sound to play it."/>
                            <Border x:Name="SoundAddProblems" CornerRadius="12" Background="{StaticResource WarnSoft}" Padding="14,12" Margin="0,4,0,12" Visibility="Collapsed">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" VerticalAlignment="Top" Click="CloseSoundProblems_Click" AutomationProperties.Name="Dismiss">
                                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource SubText}"/>
                                    </Button>
                                    <TextBlock x:Name="SoundAddProblemsText" Style="{StaticResource Hint}" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                            <ItemsControl x:Name="SoundList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="168" Margin="0,0,10,10">
                                            <Button Style="{StaticResource SoftButton}" Height="72" HorizontalContentAlignment="Stretch" Padding="14,0,34,0" Click="PlaySound_Click" Tag="{Binding}"
                                                    ToolTip="Play" AutomationProperties.Name="{Binding Name, StringFormat=Play {0}}">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding KeyText}" FontSize="11.5" Foreground="{StaticResource SubText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0" Click="RemoveSound_Click" Tag="{Binding}"
                                                    ToolTip="Remove" AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}">
                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource SubText}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Background="#16162B" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="#A5B4FC" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="Sounds are mixed into your mic inside Windows' audio engine, after the voice changer, so they aren't pitched and your mic still stays out of Discord streams. Give each sound a key on the Shortcuts page. If you Go Live with Hear sounds myself on, your stream picks up your own copy too, so viewers may hear sounds twice."/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== App mixer ===== -->
            <DockPanel x:Name="PageMixer" Visibility="Collapsed" Margin="32,26,32,26">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="App mixer" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="MixerSubtitle" Text="Set how loud each app is and where it plays. Apps show up here while they make sound." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <Border x:Name="EmptyMixer" DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Margin="0,24">
                        <TextBlock Text="&#xE767;" Style="{StaticResource Icon}" FontSize="34" Foreground="{StaticResource SubText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nothing is playing right now" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Start some music, a game or a call and it'll appear here." Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Mixer.Apps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,14,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource PrimarySoft}">
                                                <TextBlock Text="{Binding Initial}" FontWeight="ExtraBold" FontSize="16" Foreground="#C7D2FE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                            <ToggleButton Grid.Column="2" Style="{StaticResource MuteButton}" IsChecked="{Binding Muted}" Width="44" Height="38" Padding="0"
                                                          ToolTip="Mute this app" AutomationProperties.Name="{Binding Name, StringFormat=Mute {0}}">
                                                <TextBlock Text="&#xE74F;" Style="{StaticResource Icon}"/>
                                            </ToggleButton>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE767;" Style="{StaticResource Icon}" Foreground="{StaticResource SubText}" Margin="0,0,10,0"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} volume}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:0}%}" Foreground="{StaticResource SubText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Plays on" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding Output}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} output device}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- ===== Plugins ===== -->
            <ScrollViewer x:Name="PagePlugins" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,26,32,26">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="ScanButton" Style="{StaticResource SoftButton}" Height="44" Padding="16,0" Margin="0,0,10,0"
                                    Click="ScanPlugins_Click" AutomationProperties.Name="Scan this PC for plugins">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="ScanButtonText" Text="Scan for plugins" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Height="44" Padding="18,0"
                                    Click="AddPlugin_Click" AutomationProperties.Name="Add a plugin file">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" Margin="0,0,10,0"/>
                                    <TextBlock Text="Add plugin" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Plugins" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Add your own VST effects to your mic. They run after Sound cleanup and voice tone, before Voice polish and Mic boost, top to bottom." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                    </DockPanel>

                    <Border x:Name="PluginError" CornerRadius="12" Background="{StaticResource WarnSoft}" Padding="14,12" Margin="0,0,0,14" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock x:Name="PluginErrorText" Style="{StaticResource Hint}" Foreground="{StaticResource Text}" MaxWidth="700"/>
                        </StackPanel>
                    </Border>

                    <!-- Scan results -->
                    <Border x:Name="ScanCard" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed" BorderBrush="#3B3B7A">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Height="34" Padding="12,0" Click="CloseScan_Click" AutomationProperties.Name="Close scan results">
                                    <TextBlock Text="Done" FontWeight="SemiBold" FontSize="13"/>
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Height="34" Padding="12,0" Margin="0,0,8,0" Click="ScanFolder_Click" AutomationProperties.Name="Scan a specific folder">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Scan a folder…" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Found on this PC" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="ScanStatus" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                            <ItemsControl x:Name="ScanResults">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Background="{StaticResource Surface}" Padding="14,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="36" Padding="14,0" Click="AddFound_Click" Tag="{Binding}"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=Add {0}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Foreground="White" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Add" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border x:Name="EmptyPlugins" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Center" Margin="0,22">
                            <TextBlock Text="&#xEA86;" Style="{StaticResource Icon}" FontSize="34" Foreground="{StaticResource SubText}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No plugins yet" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Text="Click Add plugin and pick a 64-bit VST2 effect (.dll), like a compressor or de-esser." Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="PluginList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource PrimarySoft}" VerticalAlignment="Center">
                                            <TextBlock Text="&#xEA86;" Style="{StaticResource Icon}" FontSize="18" Foreground="#C7D2FE" HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Click="PluginToggle_Click" Margin="0,0,14,0"
                                                      AutomationProperties.Name="{Binding Name, StringFormat=Turn {0} on or off}"/>
                                            <Button Style="{StaticResource SoftButton}" Height="40" Padding="12,0" Margin="0,0,6,0" Click="PluginSettings_Click" Tag="{Binding}"
                                                    ToolTip="Open the plugin's settings window" AutomationProperties.Name="{Binding Name, StringFormat=Settings for {0}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SoftButton}" Width="40" Height="40" Margin="0,0,6,0" Click="PluginReset_Click" Tag="{Binding}" ToolTip="Reset to the plugin's defaults"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Reset {0} to defaults}">
                                                <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="13"/>
                                            </Button>
                                            <Button Style="{StaticResource SoftButton}" Width="40" Height="40" Click="PluginUp_Click" Tag="{Binding}" ToolTip="Move up"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Move {0} up}">
                                                <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="12"/>
                                            </Button>
                                            <Button Style="{StaticResource SoftButton}" Width="40" Height="40" Margin="6,0,0,0" Click="PluginDown_Click" Tag="{Binding}" ToolTip="Move down"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Move {0} down}">
                                                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="12"/>
                                            </Button>
                                            <Button Style="{StaticResource SoftButton}" Width="40" Height="40" Margin="6,0,0,0" Click="PluginRemove_Click" Tag="{Binding}" ToolTip="Remove"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border CornerRadius="12" Background="#16162B" Padding="14,12" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="#A5B4FC" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock Style="{StaticResource Hint}" MaxWidth="700"
                                       Text="Plugins run on their default settings for now. WaveFix copies each plugin to C:\ProgramData\WaveFix\Plugins so Windows' audio engine can load it. Only 64-bit VST2 (.dll) plugins work; VST3 isn't supported by the engine."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Shortcuts ===== -->
            <ScrollViewer x:Name="PageShortcuts" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,26,32,26">
                <StackPanel>
                    <TextBlock Text="Shortcuts" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Pick keys that work anywhere, even while you're in a game." Style="{StaticResource PageSubtitle}"/>

                    <ItemsControl x:Name="ShortcutList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource PrimarySoft}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Action.Glyph}" Style="{StaticResource Icon}" FontSize="18" Foreground="#C7D2FE" HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Action.Title}" Style="{StaticResource Label}" FontSize="15"/>
                                            <TextBlock Text="{Binding Action.Description}" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Warn}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Error}" FontSize="12.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource SoftButton}" MinWidth="170" Height="42" Padding="16,0" VerticalAlignment="Center"
                                                Click="ShortcutKey_Click" Tag="{Binding}" AutomationProperties.Name="{Binding Action.Title, StringFormat=Set shortcut for {0}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource SubText}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding KeyText}" FontWeight="SemiBold" FontSize="13.5"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Style="{StaticResource SoftButton}" Width="42" Height="42" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Click="ShortcutClear_Click" Tag="{Binding}" ToolTip="Remove shortcut"
                                                Visibility="{Binding HasKey, Converter={StaticResource BoolToVis}}"
                                                AutomationProperties.Name="{Binding Action.Title, StringFormat=Remove shortcut for {0}}">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border CornerRadius="12" Background="#16162B" Padding="14,12" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE82F;" Style="{StaticResource Icon}" Foreground="#A5B4FC" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock Style="{StaticResource Hint}" MaxWidth="700"
                                       Text="Tip: combine a key with Ctrl, Alt or Shift so it doesn't get in the way of typing. F-keys and numpad keys (Num 1, Num Plus...) also work on their own; numpad keys need Num Lock on. While setting a shortcut, Esc cancels and Backspace removes it."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
