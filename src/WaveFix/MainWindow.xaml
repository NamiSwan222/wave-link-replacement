<Window x:Class="WaveFix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaveFix" Width="1140" Height="720" MinWidth="960" MinHeight="600"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22,18,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,24">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource Primary}">
                        <TextBlock Text="&#xE720;" Style="{StaticResource Icon}" FontSize="19" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WaveFix" FontSize="18" FontWeight="ExtraBold"/>
                        <TextBlock Text="Clean mic, no leaks" FontSize="12" Foreground="{StaticResource SubText}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <!-- Update available -->
                    <Border x:Name="UpdateCard" CornerRadius="14" Padding="14" Margin="0,0,0,12" Background="{StaticResource PrimarySoft}"
                            BorderBrush="{StaticResource Primary}" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Foreground="#E3D7EE" Margin="0,0,8,0"/>
                                <TextBlock x:Name="UpdateTitle" Text="Update available" FontWeight="Bold" FontSize="13.5"/>
                            </StackPanel>
                            <TextBlock x:Name="UpdateText" Style="{StaticResource Hint}" Foreground="#E3D7EE" Margin="0,0,0,10"/>
                            <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Height="36" Click="UpdateNow_Click"
                                    AutomationProperties.Name="Install the update now">
                                <TextBlock x:Name="UpdateButtonText" Text="Update now" FontWeight="Bold" FontSize="13" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Quick mic: mute and a live level, from any page -->
                    <Border CornerRadius="14" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Style="{StaticResource MuteButton}" IsChecked="{Binding Mic.Muted}" Width="40" Height="36" Padding="0"
                                          ToolTip="Mute or unmute your mic" AutomationProperties.Name="Mute microphone (sidebar)">
                                <TextBlock x:Name="SideMuteIcon" Text="&#xE720;" Style="{StaticResource Icon}" FontSize="15"/>
                            </ToggleButton>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SideMicText" Text="Mic on" FontSize="12.5" FontWeight="SemiBold"/>
                                <ProgressBar Value="{Binding Mic.Level, Mode=OneWay}" Minimum="0" Maximum="1" Height="4" Margin="0,5,0,0"
                                             Foreground="{StaticResource Good}" Background="{StaticResource Surface}" BorderThickness="0"
                                             AutomationProperties.Name="Mic level"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <RadioButton x:Name="NavSetup" Style="{StaticResource NavItem}" GroupName="nav" Content="Setup &amp; help" Tag="&#xE713;" Checked="Nav_Checked" Margin="0,0,0,8"/>
                    <Border x:Name="StatusPill" CornerRadius="12" Padding="12,10" Background="{StaticResource GoodSoft}" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Good}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusPillText" Text="All good" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0" TextWrapping="Wrap" MaxWidth="160"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Your voice" Style="{StaticResource NavGroup}"/>
                    <RadioButton x:Name="NavMic" Style="{StaticResource NavItem}" GroupName="nav" Content="Microphone" Tag="&#xE720;" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavVoice" Style="{StaticResource NavItem}" GroupName="nav" Content="Voice changer" Tag="&#xE8D6;" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAi" Style="{StaticResource NavItem}" GroupName="nav" Content="AI voices" Tag="&#xE99A;" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSoundboard" Style="{StaticResource NavItem}" GroupName="nav" Content="Soundboard" Tag="&#xE7F6;" Checked="Nav_Checked"/>
                    <TextBlock Text="Apps &amp; extras" Style="{StaticResource NavGroup}" Margin="14,14,0,6"/>
                    <RadioButton x:Name="NavMixer" Style="{StaticResource NavItem}" GroupName="nav" Content="App mixer" Tag="&#xE767;" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPlugins" Style="{StaticResource NavItem}" GroupName="nav" Content="Plugins" Tag="&#xEA86;" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavShortcuts" Style="{StaticResource NavItem}" GroupName="nav" Content="Shortcuts" Tag="&#xE765;" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Pages ============ -->
        <Grid Grid.Column="1">

            <!-- ===== Setup ===== -->
            <ScrollViewer x:Name="PageSetup" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,26,32,26">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Let's set up your mic" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="WaveFix can install and connect everything for you. It takes about a minute." Style="{StaticResource PageSubtitle}"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Which mic do you talk into?" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding Mic.Devices}" SelectedItem="{Binding Mic.Selected}" Margin="0,0,0,6" AutomationProperties.Name="Microphone to set up"/>
                            <TextBlock Text="Pick your real microphone, not anything called &quot;Elgato Virtual Audio&quot;." Style="{StaticResource Hint}" Margin="0,0,0,20"/>

                            <ItemsControl x:Name="SetupSteps">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#221F2C" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{Binding Color}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Label}"/>
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border x:Name="SetupResult" CornerRadius="12" Padding="14,12" Margin="0,4,0,16" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="SetupResultText" Style="{StaticResource Hint}" Foreground="{StaticResource Text}" FontSize="13"/>
                                    <WrapPanel x:Name="SetupHelp" Margin="0,10,0,0" Visibility="Collapsed">
                                        <Button x:Name="PickPluginButton" Style="{StaticResource SoftButton}" Height="36" Padding="12,0" Margin="0,0,8,6" Click="PickPlugin_Click"
                                                AutomationProperties.Name="Use a plugin file I downloaded">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                                <TextBlock Text="Use a file I downloaded…" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="OpenPluginPageButton" Style="{StaticResource SoftButton}" Height="36" Padding="12,0" Margin="0,0,8,6" Click="OpenPluginPage_Click"
                                                AutomationProperties.Name="Open the plugin download page">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                                <TextBlock Text="Open the download page" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SoftButton}" Height="36" Padding="12,0" Margin="0,0,8,6" Click="CopySetupLog_Click"
                                                AutomationProperties.Name="Copy setup details">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="CopyLogText" Text="Copy details" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SetupButton" Style="{StaticResource PrimaryButton}" Height="48" Padding="22,0" Click="RunSetup_Click"
                                        AutomationProperties.Name="Run setup">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="SetupButtonText" Text="Set it up for me" FontWeight="Bold" FontSize="14.5" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="TestEffectsButton" Style="{StaticResource SoftButton}" Height="48" Padding="18,0" Margin="10,0,0,0" Click="TestEffects_Click"
                                        AutomationProperties.Name="Test my effects"
                                        ToolTip="Records from this mic for a moment and checks that WaveFix's engine is running on it. Adds no sound.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="TestEffectsText" Text="Test my effects" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <WrapPanel Margin="2,12,0,0">
                                <Button x:Name="UndoSetupButton" Style="{StaticResource LinkButton}" Margin="0,0,18,4" VerticalAlignment="Center" Click="UndoSetup_Click"
                                        Visibility="Collapsed" AutomationProperties.Name="Take WaveFix's engine off this mic"
                                        ToolTip="Puts this mic's original Windows effect settings back (one permission prompt).">
                                    <TextBlock Text="Take the engine off this mic" FontSize="12.5" Foreground="{StaticResource SubText}"/>
                                </Button>
                                <Button Style="{StaticResource LinkButton}" Margin="0,0,18,4" VerticalAlignment="Center" Click="CopyDiagnostics_Click"
                                        AutomationProperties.Name="Copy details for help"
                                        ToolTip="Copies what WaveFix and Windows report about your mic and the engine, to paste when asking for help.">
                                    <TextBlock Text="Copy details for help" FontSize="12.5" Foreground="{StaticResource SubText}"/>
                                </Button>
                                <Button x:Name="RemoveEngineButton" Style="{StaticResource LinkButton}" Margin="0,0,18,4" VerticalAlignment="Center" Click="RemoveEngine_Click"
                                        Visibility="Collapsed" AutomationProperties.Name="Remove the WaveFix engine"
                                        ToolTip="Takes WaveFix's engine off every mic (their original settings come back) and deletes it from Program Files.">
                                    <TextBlock Text="Remove the WaveFix engine" FontSize="12.5" Foreground="{StaticResource SubText}"/>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Background="#1C1925" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="#CDBBDD" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock x:Name="SetupNote" Grid.Column="1" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="Windows will ask for permission once. Your sound drops for a few seconds at the end while Windows audio restarts."/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="WaveFix" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                        <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Checked="StartupSwitch_Changed" Unchecked="StartupSwitch_Changed"
                                  AutomationProperties.Name="Start WaveFix with Windows" Margin="0">
                            <TextBlock Text="Start with Windows" Style="{StaticResource Label}"/>
                        </CheckBox>
                        <CheckBox x:Name="AutoUpdateSwitch" Style="{StaticResource Switch}" Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed"
                                  AutomationProperties.Name="Install updates automatically" Margin="0,14,0,0">
                            <TextBlock Text="Auto-update" Style="{StaticResource Label}"/>
                        </CheckBox>
                        <Button Style="{StaticResource LinkButton}" Margin="0,16,0,0" HorizontalAlignment="Left" Click="CheckUpdates_Click"
                                AutomationProperties.Name="Check for updates">
                            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource SubText}"/>
                        </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Microphone ===== -->
            <ScrollViewer x:Name="PageMic" VerticalScrollBarVisibility="Auto" Padding="32,26,32,26">
                <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
                    <TextBlock Text="Your microphone" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Sound clean and clear everywhere, without your mic leaking into Discord streams." Style="{StaticResource PageSubtitle}"/>

                    <!-- Friendly status banner -->
                    <Border x:Name="Banner" CornerRadius="14" Padding="16,14" Margin="0,0,0,20" Background="{StaticResource GoodSoft}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BannerAction" Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="40" Padding="16,0" Margin="14,0,0,0"
                                    VerticalAlignment="Center" Click="OpenSetup_Click" Visibility="Collapsed" AutomationProperties.Name="Set it up for me">
                                <TextBlock Text="Set it up for me" FontWeight="Bold" FontSize="13.5" Foreground="White"/>
                            </Button>
                            <Border x:Name="BannerIconBg" Width="34" Height="34" CornerRadius="17" Background="{StaticResource Good}" VerticalAlignment="Top">
                                <TextBlock x:Name="BannerIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="15" Foreground="#13111A" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="BannerTitle" Text="You're all set" FontSize="15" FontWeight="Bold"/>
                                <TextBlock x:Name="BannerText" Style="{StaticResource Hint}" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Level & volume -->
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Height="32" Padding="12,0" Click="MicSetup_Click"
                                            ToolTip="Talk for a few seconds and WaveFix sets your level, noise removal and tone" AutomationProperties.Name="Set up my mic for me">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9F5;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Set up my mic for me" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Level &amp; volume" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="Microphone" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding Mic.Devices}" SelectedItem="{Binding Mic.Selected}" Margin="0,0,0,20"
                                          AutomationProperties.Name="Microphone"/>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="MeterHint" DockPanel.Dock="Right" Style="{StaticResource Hint}" Text="Talk to see your level"/>
                                    <TextBlock Text="Live level" Style="{StaticResource Label}"/>
                                </DockPanel>
                                <Border Height="16" CornerRadius="8" Background="#221F2C" ClipToBounds="True" Margin="0,0,0,22">
                                    <Grid x:Name="MeterHost">
                                        <Border x:Name="MeterFill" HorizontalAlignment="Left" CornerRadius="8" Width="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#22C55E" Offset="0"/>
                                                    <GradientStop Color="#22C55E" Offset="0.68"/>
                                                    <GradientStop Color="#F97316" Offset="0.86"/>
                                                    <GradientStop Color="#EF4444" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="{Binding Mic.Gain, StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Input level" Style="{StaticResource Label}"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="100" Value="{Binding Mic.Gain}" Margin="0,0,0,14" AutomationProperties.Name="Input level"/>

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock x:Name="BoostValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Mic boost" Style="{StaticResource Label}"/>
                                </DockPanel>
                                <Slider x:Name="BoostSlider" Minimum="-6" Maximum="24" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Boost_Changed"
                                        AutomationProperties.Name="Mic boost"/>
                                <TextBlock x:Name="BoostHint" Style="{StaticResource Hint}" Margin="0,4,0,22"
                                           Text="Need to be louder? Turn up the input level first, then add boost. If the meter turns red, back off a little."/>

                                <ToggleButton x:Name="MuteToggle" Style="{StaticResource MuteButton}" IsChecked="{Binding Mic.Muted}" Height="54"
                                              AutomationProperties.Name="Mute microphone">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MuteIcon" Text="&#xE720;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="MuteLabel" Text="Mic is on, click to mute" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>

                                <CheckBox x:Name="HearMyselfMicSwitch" Style="{StaticResource Switch}" Margin="0,20,0,0" Click="HearMyselfSwitch_Click" AutomationProperties.Name="Hear myself">
                                    <StackPanel>
                                        <TextBlock Text="Hear myself" Style="{StaticResource Label}"/>
                                        <TextBlock Text="Plays your mic to your headphones exactly as others hear it, effects and AI voice included." Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel x:Name="HearMyselfPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock x:Name="HearMyselfValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Volume" Style="{StaticResource Label}"/>
                                    </DockPanel>
                                    <Slider x:Name="HearMyselfSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" ValueChanged="HearMyselfVolume_Changed" AutomationProperties.Name="Hear myself volume"/>
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Use headphones (speakers would echo into your mic). While it's on, a screen share with sound also carries your voice, so turn it off before streaming."/>
                                    <TextBlock x:Name="HearMyselfError" Style="{StaticResource Hint}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Sound cleanup -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Sound cleanup" Style="{StaticResource CardTitle}" Margin="0,0,0,16"/>

                                <CheckBox x:Name="NoiseSwitch" Style="{StaticResource Switch}" Click="NoiseSwitch_Click"
                                          AutomationProperties.Name="Noise removal" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Noise removal" Style="{StaticResource Label}"/>
                                        <TextBlock Text="Hides keyboard clicks, fans and room noise between your words." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                                <WrapPanel Margin="0,0,0,8">
                                    <RadioButton x:Name="NoiseStandard" Style="{StaticResource ToneChoice}" GroupName="noisemodel" Content="Standard" Tag="Light on your PC" Checked="NoiseModel_Checked"
                                                 AutomationProperties.Name="Standard noise removal"/>
                                    <RadioButton x:Name="NoiseStrong" Style="{StaticResource ToneChoice}" GroupName="noisemodel" Content="Strong" Tag="Cleaner, more natural" Checked="NoiseModel_Checked"
                                                 AutomationProperties.Name="Strong noise removal"/>
                                </WrapPanel>
                                <StackPanel x:Name="StrongNoisePanel" Margin="0,0,0,18" Visibility="Collapsed">
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock x:Name="NoiseStrengthValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="How much noise to remove" Style="{StaticResource Label}"/>
                                    </DockPanel>
                                    <Slider x:Name="NoiseStrengthSlider" Minimum="10" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                                            ValueChanged="NoiseStrength_Changed" AutomationProperties.Name="How much noise to remove"/>
                                    <TextBlock x:Name="StrongNoiseNote" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="DeepFilterNet, an AI model built into WaveFix's audio engine. Lower keeps a little room sound, which can sound more natural. Adds about 40 ms of delay."/>
                                </StackPanel>
                                <StackPanel x:Name="StandardNoisePanel" Orientation="Horizontal" Margin="0,0,0,18">
                                    <Button Style="{StaticResource SoftButton}" Height="32" Padding="12,0" Click="NoiseSettings_Click"
                                            AutomationProperties.Name="Adjust noise removal">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Adjust" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="NoiseResetButton" Style="{StaticResource LinkButton}" Margin="12,0,0,0" VerticalAlignment="Center" Click="NoiseReset_Click"
                                            AutomationProperties.Name="Reset noise removal to defaults">
                                        <TextBlock Text="Reset to default" FontSize="12.5" Foreground="{StaticResource SubText}"/>
                                    </Button>
                                </StackPanel>

                                <CheckBox x:Name="LowCutSwitch" Style="{StaticResource Switch}" Click="LowCutSwitch_Click"
                                          AutomationProperties.Name="Low cut" Margin="0,0,0,22">
                                    <StackPanel>
                                        <TextBlock Text="Rumble filter" Style="{StaticResource Label}"/>
                                        <TextBlock Text="Cuts desk bumps and low hum (below 80 Hz)." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <TextBlock Text="Voice tone" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                                <WrapPanel x:Name="PresetPanel" Margin="0,0,0,10"/>
                                <StackPanel x:Name="CustomEqPanel" Visibility="Collapsed" Margin="0,4,0,6">
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="CustomEqReset_Click" AutomationProperties.Name="Reset custom tone">
                                            <TextBlock Text="Reset" FontSize="12.5" Foreground="{StaticResource SubText}"/>
                                        </Button>
                                        <TextBlock Text="Shape your own tone. Small moves (2 to 4 dB) go a long way." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <StackPanel x:Name="CustomEqBands"/>
                                </StackPanel>

                                <Border CornerRadius="12" Background="#1C1925" Padding="14,12" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="#CDBBDD" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Hint}"
                                                   Text="All of this runs inside Windows' own audio engine, so Discord streams can't pick up your mic."/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Voice polish -->
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Voice polish" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Text="Studio tools that make you sound steady and pro. Like everything here, they run in Windows' audio engine." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,18">
                                    <CheckBox x:Name="LevelerSwitch" Style="{StaticResource Switch}" Click="Polish_Click" AutomationProperties.Name="Leveler">
                                        <StackPanel>
                                            <TextBlock Text="Leveler" Style="{StaticResource Label}"/>
                                            <TextBlock Text="Evens out loud and quiet moments so you're always easy to hear (a compressor)." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <DockPanel Margin="0,10,0,2">
                                        <TextBlock x:Name="LevelerValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Strength" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider x:Name="LevelerSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" ValueChanged="Polish_Changed" AutomationProperties.Name="Leveler strength"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,18">
                                    <CheckBox x:Name="DeEsserSwitch" Style="{StaticResource Switch}" Click="Polish_Click" AutomationProperties.Name="De-esser">
                                        <StackPanel>
                                            <TextBlock Text="De-esser" Style="{StaticResource Label}"/>
                                            <TextBlock Text="Softens sharp S and SH sounds without dulling your voice." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <DockPanel Margin="0,10,0,2">
                                        <TextBlock x:Name="DeEsserValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Strength" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider x:Name="DeEsserSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" ValueChanged="Polish_Changed" AutomationProperties.Name="De-esser strength"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,0,0">
                                    <CheckBox x:Name="SilencerSwitch" Style="{StaticResource Switch}" Click="Polish_Click" AutomationProperties.Name="Background silencer">
                                        <StackPanel>
                                            <TextBlock Text="Background silencer" Style="{StaticResource Label}"/>
                                            <TextBlock Text="Turns down quiet sounds while you aren't talking (an expander)." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <DockPanel Margin="0,10,0,2">
                                        <TextBlock x:Name="SilencerValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Sensitivity" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider x:Name="SilencerSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" ValueChanged="Polish_Changed" AutomationProperties.Name="Background silencer sensitivity"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,0">
                                    <CheckBox x:Name="LimiterSwitch" Style="{StaticResource Switch}" Click="Polish_Click" AutomationProperties.Name="Peak protection">
                                        <StackPanel>
                                            <TextBlock Text="Peak protection" Style="{StaticResource Label}"/>
                                            <TextBlock Text="Stops shouts and laughs from clipping. Runs last, after mic boost (a limiter)." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <DockPanel Margin="0,10,0,2">
                                        <TextBlock x:Name="LimiterValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Loudest allowed" Style="{StaticResource Hint}"/>
                                    </DockPanel>
                                    <Slider x:Name="LimiterSlider" Minimum="-12" Maximum="0" TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="1" ValueChanged="Polish_Changed" AutomationProperties.Name="Peak protection loudest allowed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Voice changer ===== -->
            <ScrollViewer x:Name="PageVoice" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,26,32,26">
                <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
                    <TextBlock Text="Voice changer" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Sound like someone (or something) else in Discord, games and every other app." Style="{StaticResource PageSubtitle}"/>

                    <Border x:Name="FxMissing" CornerRadius="12" Background="{StaticResource WarnSoft}" Padding="14,12" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource Text}" TextWrapping="Wrap"
                                   Text="This copy of WaveFix was built without its voice effects, so the voice changer and voice polish can't run. Install the latest release to get them."/>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <CheckBox x:Name="VoiceSwitch" Style="{StaticResource Switch}" Click="VoiceSwitch_Click" AutomationProperties.Name="Voice changer">
                            <StackPanel>
                                <TextBlock Text="Voice changer" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="VoiceStateText" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Voices" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                            <StackPanel x:Name="VoicePresetPanel"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button x:Name="VoiceResetButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="VoiceReset_Click" AutomationProperties.Name="Reset the voice to its preset">
                                    <TextBlock Text="Back to preset" FontSize="12.5" Foreground="{StaticResource SubText}"/>
                                </Button>
                                <TextBlock Text="Fine tune" Style="{StaticResource CardTitle}"/>
                            </DockPanel>
                            <TextBlock Text="Moving a slider makes it your own Custom voice." Style="{StaticResource Hint}" Margin="0,0,0,16"/>
                            <Grid x:Name="VoiceSliders">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Background="#1C1925" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="#CDBBDD" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="Like your other effects, the voice changer runs inside Windows' audio engine, so Discord streams still can't pick up your mic. Changing pitch adds a small delay (about 40 ms). Set a shortcut to switch voices mid-game."/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Soundboard ===== -->
            <!-- ===== AI voices ===== -->
            <ScrollViewer x:Name="PageAi" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,26,32,26"
                          AllowDrop="True" DragOver="AiVoices_DragOver" Drop="AiVoices_Drop">
                <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
                    <TextBlock Text="AI voices" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Sound like a different person with an RVC voice model. It runs on your PC, inside WaveFix: your voice isn't sent anywhere." Style="{StaticResource PageSubtitle}"/>

                    <Border x:Name="AiNotice" CornerRadius="12" Background="{StaticResource WarnSoft}" Padding="14,12" Margin="0,0,0,16" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" VerticalAlignment="Top" Click="CloseAiNotice_Click" AutomationProperties.Name="Dismiss">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource SubText}"/>
                            </Button>
                            <TextBlock x:Name="AiNoticeText" Style="{StaticResource Hint}" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <CheckBox x:Name="AiSwitch" Style="{StaticResource Switch}" Click="AiSwitch_Click" AutomationProperties.Name="AI voice">
                            <StackPanel>
                                <TextBlock Text="AI voice" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="AiStateText" Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <Border x:Name="AiDownloadCard" Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="One-time download" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="AiDownloadText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <ProgressBar x:Name="AiDownloadProgress" Height="6" Minimum="0" Maximum="1" Margin="0,0,0,14" Visibility="Collapsed"
                                         Foreground="{StaticResource PrimaryLine}" Background="{StaticResource Surface}" BorderThickness="0"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AiDownloadButton" Style="{StaticResource PrimaryButton}" Height="38" Padding="16,0" Click="AiDownload_Click" AutomationProperties.Name="Download AI voice support">
                                    <TextBlock Text="Download" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="AiCancelButton" Style="{StaticResource SoftButton}" Height="38" Padding="14,0" Margin="8,0,0,0" Click="AiCancel_Click" Visibility="Collapsed" AutomationProperties.Name="Cancel download">
                                    <TextBlock Text="Cancel" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Button x:Name="AiAddButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="38" Padding="16,0" Click="AiAdd_Click" AutomationProperties.Name="Add a voice model">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Foreground="White" Margin="0,0,8,0"/>
                                        <TextBlock Text="Add voice model" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Height="38" Padding="14,0" Margin="0,0,8,0" Click="AiBrowse_Click" AutomationProperties.Name="Find voices online">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Find voices online" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Voices" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="AiEmpty" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="No voices yet. Click Add voice model (or drop a file here) and pick an RVC model: the .pth file, usually 50 to 60 MB. v1 and v2 models at 32, 40 or 48 kHz work. Index files (.index) aren't needed."/>
                            <WrapPanel x:Name="AiVoiceList"/>

                            <!-- Voices online (Hugging Face) -->
                            <Border x:Name="AiBrowseCard" CornerRadius="12" Background="{StaticResource CardRaised}" BorderBrush="#4A3D55" BorderThickness="1" Padding="16,14" Margin="0,10,0,4" Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Height="32" Padding="12,0" Click="AiBrowseClose_Click" AutomationProperties.Name="Close voice search">
                                            <TextBlock Text="Done" FontWeight="SemiBold" FontSize="12.5"/>
                                        </Button>
                                        <TextBlock Text="Voices online" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBox x:Name="AiBrowseSearch" Style="{StaticResource SearchBox}" KeyDown="AiBrowseSearch_KeyDown" TextChanged="AiBrowseSearch_Changed" AutomationProperties.Name="Search voices online"/>
                                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource SubText}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBlock x:Name="AiBrowseHint" Text="Search, then press Enter (empty shows the most popular)" Foreground="{StaticResource SubText}" FontSize="13.5" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                    <TextBlock x:Name="AiBrowseStatus" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="AiBrowseResults">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10" Background="{StaticResource Surface}" Padding="14,8" Margin="0,0,6,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource LinkButton}" Margin="0,0,12,0" VerticalAlignment="Center" Click="AiBrowsePage_Click" Tag="{Binding}" ToolTip="Open its page (license and details)"
                                                                        AutomationProperties.Name="{Binding Name, StringFormat=Open the page for {0}}">
                                                                    <TextBlock Text="Page" FontSize="12.5" Foreground="{StaticResource SubText}"/>
                                                                </Button>
                                                                <Button Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" Click="AiBrowseAdd_Click" Tag="{Binding}"
                                                                        AutomationProperties.Name="{Binding Name, StringFormat=Add the voice {0}}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="11" Foreground="White" Margin="0,0,8,0"/>
                                                                        <TextBlock Text="Add" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="From Hugging Face, where people share RVC voices. Check each voice's license on its page. Only use voices you're allowed to, and don't use someone's voice to pretend to be them."/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="AiImportText" Style="{StaticResource Hint}" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock x:Name="AiPitchValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                <TextBlock Text="Pitch" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Saved per voice. Deep voice into a high-voiced model: about +12. High voice into a deep-voiced model: about -12."/>
                            <Slider x:Name="AiPitchSlider" Minimum="-24" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="12"
                                    ValueChanged="AiPitch_Changed" AutomationProperties.Name="AI voice pitch"/>
                            <CheckBox x:Name="AiGpuSwitch" Style="{StaticResource Switch}" Margin="0,18,0,0" Click="AiOptions_Click" AutomationProperties.Name="Use my graphics card">
                                <StackPanel>
                                    <TextBlock Text="Use my graphics card" Style="{StaticResource Label}"/>
                                    <TextBlock Text="Much faster, so the delay is shorter. Turn off if your graphics card has problems." Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="AiSilentSwitch" Style="{StaticResource Switch}" Margin="0,14,0,0" Click="AiOptions_Click" AutomationProperties.Name="Never send my real voice">
                                <StackPanel>
                                    <TextBlock Text="Never send my real voice" Style="{StaticResource Label}"/>
                                    <TextBlock Text="If the AI voice stops (it's starting up, your PC can't keep up, or WaveFix closed), your mic goes silent instead of falling back to your normal voice." Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="HearMyselfAiSwitch" Style="{StaticResource Switch}" Margin="0,14,0,0" Click="HearMyselfSwitch_Click" AutomationProperties.Name="Hear myself (AI voices page)">
                                <StackPanel>
                                    <TextBlock Text="Hear myself" Style="{StaticResource Label}"/>
                                    <TextBlock Text="Hear the AI voice in your headphones as others hear it (volume on the Microphone page)." Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <Button Style="{StaticResource LinkButton}" Click="AiAdvancedToggle_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Show advanced AI voice settings">
                                <DockPanel>
                                    <TextBlock x:Name="AiAdvancedChevron" DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource SubText}" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="Advanced" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Background noise, loudness, index file and speaker. The defaults suit most models." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <StackPanel x:Name="AiAdvancedPanel" Margin="0,18,0,0" Visibility="Collapsed">
                                <CheckBox x:Name="AiAutoGateSwitch" Style="{StaticResource Switch}" Click="AiAdvancedOption_Click" AutomationProperties.Name="Ignore background noise automatically">
                                    <StackPanel>
                                        <TextBlock Text="Ignore background noise automatically" Style="{StaticResource Label}"/>
                                        <TextBlock Text="Learns your mic's background noise, so pauses stay silent instead of the AI babbling." Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <DockPanel Margin="0,16,0,2">
                                    <TextBlock x:Name="AiGateValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Silence threshold" Style="{StaticResource Label}"/>
                                </DockPanel>
                                <Slider x:Name="AiGateSlider" Minimum="-70" Maximum="-20" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"
                                        ValueChanged="AiGate_Changed" AutomationProperties.Name="Silence threshold"/>
                                <TextBlock x:Name="AiGateHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                <DockPanel Margin="0,16,0,2">
                                    <TextBlock x:Name="AiLoudnessValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Loudness" Style="{StaticResource Label}"/>
                                </DockPanel>
                                <Slider x:Name="AiLoudnessSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25"
                                        ValueChanged="AiVoiceAdvanced_Changed" AutomationProperties.Name="AI voice loudness mix"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Left: the AI voice follows how loud you speak (most natural). Right: the model's own loudness. Saved per voice."/>

                                <DockPanel Margin="0,16,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="AiIndexAddButton" Style="{StaticResource SoftButton}" Height="32" Padding="12,0" Click="AiIndexAdd_Click" AutomationProperties.Name="Add an index file">
                                            <TextBlock Text="Add index file…" FontWeight="SemiBold" FontSize="12.5"/>
                                        </Button>
                                        <Button x:Name="AiIndexRemoveButton" Style="{StaticResource LinkButton}" Margin="10,0,0,0" VerticalAlignment="Center" Click="AiIndexRemove_Click" AutomationProperties.Name="Remove the index file">
                                            <TextBlock Text="Remove" FontSize="12.5" Foreground="{StaticResource SubText}"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Index file" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="AiIndexName" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel x:Name="AiIndexRatePanel">
                                    <DockPanel Margin="0,4,0,2">
                                        <TextBlock x:Name="AiIndexRateValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Index strength" Style="{StaticResource Label}"/>
                                    </DockPanel>
                                    <Slider x:Name="AiIndexRateSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25"
                                            ValueChanged="AiVoiceAdvanced_Changed" AutomationProperties.Name="Index strength"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="The .index file that often comes with a voice model (the one named added_…). It pulls the voice toward the original speaker's accent and tone. Higher sounds more like them but can blur words; 50 to 75% suits most."/>

                                <StackPanel x:Name="AiSpeakerPanel" Visibility="Collapsed">
                                    <DockPanel Margin="0,16,0,2">
                                        <TextBlock x:Name="AiSpeakerValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Speaker" Style="{StaticResource Label}"/>
                                    </DockPanel>
                                    <Slider x:Name="AiSpeakerSlider" Minimum="0" Maximum="1" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
                                            ValueChanged="AiVoiceAdvanced_Changed" AutomationProperties.Name="Speaker"/>
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Text="This model holds several voices; pick which one you sound like."/>
                                </StackPanel>

                                <Button Style="{StaticResource LinkButton}" Margin="0,16,0,0" HorizontalAlignment="Left" Click="AiAdvancedReset_Click" AutomationProperties.Name="Reset advanced settings">
                                    <TextBlock Text="Reset advanced settings" FontSize="12.5" Foreground="{StaticResource SubText}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Background="#1C1925" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="#CDBBDD" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="AI voices add a delay (about 0.4 s with a graphics card, more without one). The voice changer and other effects still apply on top. Only use voice models you're allowed to, and don't use someone's voice to pretend to be them."/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PageSoundboard" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,26,32,26"
                          AllowDrop="True" DragOver="Soundboard_DragOver" Drop="Soundboard_Drop">
                <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
                    <TextBlock Text="Soundboard" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Play sound effects into your mic. Everyone in Discord, games and calls hears them." Style="{StaticResource PageSubtitle}"/>

                    <Border x:Name="SoundboardNotice" CornerRadius="12" Background="{StaticResource WarnSoft}" Padding="14,12" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock x:Name="SoundboardNoticeText" Style="{StaticResource Hint}" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <CheckBox x:Name="SoundboardSwitch" Style="{StaticResource Switch}" Click="SoundboardSwitch_Click" AutomationProperties.Name="Soundboard">
                                <StackPanel>
                                    <TextBlock Text="Soundboard" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock x:Name="SoundboardStateText" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock x:Name="SoundVolumeValue" DockPanel.Dock="Right" Foreground="{StaticResource SubText}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Volume for everyone else" Style="{StaticResource Label}"/>
                                    </DockPanel>
                                    <Slider x:Name="SoundVolumeSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" ValueChanged="SoundVolume_Changed" AutomationProperties.Name="Soundboard volume for everyone else"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <CheckBox x:Name="HearMyselfSwitch" Style="{StaticResource Switch}" Click="HearMyself_Click" AutomationProperties.Name="Hear sounds myself">
                                        <TextBlock Text="Hear sounds myself" Style="{StaticResource Label}"/>
                                    </CheckBox>
                                    <Slider x:Name="MyVolumeSlider" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" Margin="0,8,0,0" ValueChanged="SoundVolume_Changed" AutomationProperties.Name="Soundboard volume for me"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource SoftButton}" Height="38" Padding="14,0" Margin="0,0,8,0" Click="StopSounds_Click" AutomationProperties.Name="Stop all sounds">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Stop all" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SoftButton}" Height="38" Padding="14,0" Margin="0,0,8,0" Click="SoundBrowse_Click" AutomationProperties.Name="Find sounds online">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="Find sounds online" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AddSoundsButton" Style="{StaticResource PrimaryButton}" Height="38" Padding="16,0" Click="AddSounds_Click" AutomationProperties.Name="Add sounds">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="Add sounds" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Sounds" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Sounds online (Openverse) -->
                            <Border x:Name="SoundBrowseCard" CornerRadius="12" Background="{StaticResource CardRaised}" BorderBrush="#4A3D55" BorderThickness="1" Padding="16,14" Margin="0,0,0,14" Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Height="32" Padding="12,0" Click="SoundBrowseClose_Click" AutomationProperties.Name="Close sound search">
                                            <TextBlock Text="Done" FontWeight="SemiBold" FontSize="12.5"/>
                                        </Button>
                                        <TextBlock Text="Sounds online" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBox x:Name="SoundBrowseSearch" Style="{StaticResource SearchBox}" KeyDown="SoundBrowseSearch_KeyDown" TextChanged="SoundBrowseSearch_Changed" AutomationProperties.Name="Search sounds online"/>
                                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource SubText}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBlock x:Name="SoundBrowseHint" Text="Search, like airhorn, applause or drum roll, then press Enter" Foreground="{StaticResource SubText}" FontSize="13.5" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                    <TextBlock x:Name="SoundBrowseStatus" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="SoundBrowseResults">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10" Background="{StaticResource Surface}" Padding="14,8" Margin="0,0,6,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource SoftButton}" Height="32" Padding="12,0" Margin="0,0,8,0" Click="SoundBrowsePlay_Click" Tag="{Binding}" ToolTip="Preview (only you hear it)"
                                                                        AutomationProperties.Name="{Binding Title, StringFormat=Preview {0}}">
                                                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11"/>
                                                                </Button>
                                                                <Button Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" Click="SoundBrowseAdd_Click" Tag="{Binding}"
                                                                        AutomationProperties.Name="{Binding Title, StringFormat=Add the sound {0}}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Foreground="White" Margin="0,0,8,0"/>
                                                                        <TextBlock Text="Add" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="Openly licensed sounds from Freesound, Wikimedia Commons and more, found with Openverse. Each keeps its credit (hover a sound on your board). CC0 sounds are free for anything; CC BY ones ask you to credit the creator if you share recordings."/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="EmptySounds" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,8"
                                       Text="No sounds yet. Click Add sounds or drop files here: MP3, WAV, M4A, WMA, AAC or FLAC, up to 15 minutes each. Click a sound to play it."/>
                            <Border x:Name="SoundAddProblems" CornerRadius="12" Background="{StaticResource WarnSoft}" Padding="14,12" Margin="0,4,0,12" Visibility="Collapsed">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" VerticalAlignment="Top" Click="CloseSoundProblems_Click" AutomationProperties.Name="Dismiss">
                                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource SubText}"/>
                                    </Button>
                                    <TextBlock x:Name="SoundAddProblemsText" Style="{StaticResource Hint}" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                            <ItemsControl x:Name="SoundList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="168" Margin="0,0,10,10">
                                            <Button Style="{StaticResource SoftButton}" Height="72" HorizontalContentAlignment="Stretch" Padding="14,0,34,0" Click="PlaySound_Click" Tag="{Binding}"
                                                    ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Name, StringFormat=Play {0}}">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding KeyText}" FontSize="11.5" Foreground="{StaticResource SubText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0" Click="RemoveSound_Click" Tag="{Binding}"
                                                    ToolTip="Remove" AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}">
                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource SubText}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Background="#1C1925" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="#CDBBDD" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="Sounds are mixed into your mic inside Windows' audio engine, after the voice changer, so they aren't pitched and your mic still stays out of Discord streams. Give each sound a key on the Shortcuts page. If you Go Live with Hear sounds myself on, your stream picks up your own copy too, so viewers may hear sounds twice."/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== App mixer ===== -->
            <DockPanel x:Name="PageMixer" Visibility="Collapsed" Margin="32,26,32,26">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="App mixer" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="MixerSubtitle" Text="Set how loud each app is and where it plays. Apps show up here while they make sound." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <Border x:Name="EmptyMixer" DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Margin="0,24">
                        <TextBlock Text="&#xE767;" Style="{StaticResource Icon}" FontSize="34" Foreground="{StaticResource SubText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nothing is playing right now" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Start some music, a game or a call and it'll appear here." Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Mixer.Apps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,14,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource PrimarySoft}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" Visibility="{Binding InitialVisibility}" FontWeight="ExtraBold" FontSize="16" Foreground="#E3D7EE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                            <ToggleButton Grid.Column="2" Style="{StaticResource MuteButton}" IsChecked="{Binding Muted}" Width="44" Height="38" Padding="0"
                                                          ToolTip="Mute this app" AutomationProperties.Name="{Binding Name, StringFormat=Mute {0}}">
                                                <TextBlock Text="&#xE74F;" Style="{StaticResource Icon}"/>
                                            </ToggleButton>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE767;" Style="{StaticResource Icon}" Foreground="{StaticResource SubText}" Margin="0,0,10,0"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} volume}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:0}%}" Foreground="{StaticResource SubText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Plays on" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding Output}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} output device}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- ===== Plugins ===== -->
            <ScrollViewer x:Name="PagePlugins" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,26,32,26">
                <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="ScanButton" Style="{StaticResource SoftButton}" Height="44" Padding="16,0" Margin="0,0,10,0"
                                    Click="ScanPlugins_Click" AutomationProperties.Name="Scan this PC for plugins">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="ScanButtonText" Text="Find plugins on this PC" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Height="44" Padding="18,0"
                                    Click="AddPlugin_Click" AutomationProperties.Name="Add a plugin file">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" Margin="0,0,10,0"/>
                                    <TextBlock Text="Add a file" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Plugins" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Your own VST effects, added to your mic." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                    </DockPanel>

                    <Border x:Name="PluginError" CornerRadius="12" Background="{StaticResource WarnSoft}" Padding="14,12" Margin="0,0,0,14" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock x:Name="PluginErrorText" Style="{StaticResource Hint}" Foreground="{StaticResource Text}" MaxWidth="700" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Plugins already installed in WaveFix's folder but not in the list -->
                    <Border x:Name="OrphanCard" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Installed, not in your list" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="You added these before (they're still installed), but they aren't in your mic chain. Add one back with a click, no Windows prompt."/>
                            <ItemsControl x:Name="OrphanList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SoftButton}" Height="36" Padding="12,0" Margin="0,0,8,8" Click="AddOrphan_Click" Tag="{Binding}"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Add {0} back}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Scan results -->
                    <Border x:Name="ScanCard" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed" BorderBrush="#4A3D55">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Height="34" Padding="12,0" Click="CloseScan_Click" AutomationProperties.Name="Close scan results">
                                    <TextBlock Text="Done" FontWeight="SemiBold" FontSize="13"/>
                                </Button>
                                <Button x:Name="ScanAgainButton" DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Height="34" Padding="12,0" Margin="0,0,8,0" Click="ScanAgain_Click" AutomationProperties.Name="Scan again">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Scan again" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Height="34" Padding="12,0" Margin="0,0,8,0" Click="ScanFolder_Click" AutomationProperties.Name="Scan a specific folder">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Text="Look in a folder…" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Found on this PC" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="ScanStatus" Style="{StaticResource Hint}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <Grid x:Name="ScanSearchRow" Margin="0,0,0,12" Visibility="Collapsed">
                                <TextBox x:Name="ScanSearch" Style="{StaticResource SearchBox}" TextChanged="ScanSearch_Changed" AutomationProperties.Name="Search found plugins"/>
                                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource SubText}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock x:Name="ScanSearchHint" Text="Search by name, like Pro-Q or compressor" Foreground="{StaticResource SubText}" FontSize="13.5" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ScanResults">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Background="{StaticResource Surface}" Padding="14,8" Margin="0,0,6,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" Click="AddFound_Click" Tag="{Binding}"
                                                            AutomationProperties.Name="{Binding Name, StringFormat=Add {0}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" Foreground="White" Margin="0,0,8,0"/>
                                                            <TextBlock Text="Add" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- The chain -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Your mic chain" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"
                                       Text="Sound cleanup and voice tone → your plugins, top to bottom → voice polish, voice changer and mic boost. Changes apply to your mic straight away."/>

                            <StackPanel x:Name="EmptyPlugins" HorizontalAlignment="Center" Margin="0,14,0,10">
                                <TextBlock Text="&#xEA86;" Style="{StaticResource Icon}" FontSize="30" Foreground="{StaticResource SubText}" HorizontalAlignment="Center"/>
                                <TextBlock Text="No plugins yet" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                                <TextBlock Text="Click Find plugins on this PC, or Add a file and pick a 64-bit VST2 effect (.dll)." Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl x:Name="PluginList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource PrimarySoft}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Position}" FontWeight="Bold" FontSize="12.5" Foreground="#E3D7EE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Style="{StaticResource SoftButton}" Height="36" Padding="14,0" Click="PluginSettings_Click" Tag="{Binding}"
                                                            ToolTip="Open the plugin's own window" AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                                            <TextBlock Text="Open" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Click="PluginToggle_Click" Margin="4,0,8,0" VerticalAlignment="Center"
                                                              ToolTip="On or off" AutomationProperties.Name="{Binding Name, StringFormat=Turn {0} on or off}"/>
                                                    <Button Grid.Column="4" Style="{StaticResource SoftButton}" Width="36" Height="36" Click="PluginMore_Click" Tag="{Binding}"
                                                            ToolTip="More: move, reset, remove" AutomationProperties.Name="{Binding Name, StringFormat=More for {0}}">
                                                        <TextBlock Text="&#xE712;" Style="{StaticResource Icon}" FontSize="13"/>
                                                    </Button>
                                                </Grid>
                                                <WrapPanel Margin="42,10,0,2" Visibility="{Binding Expanded, Converter={StaticResource BoolToVis}}">
                                                    <Button Style="{StaticResource SoftButton}" Height="32" Padding="12,0" Margin="0,0,8,0" Click="PluginUp_Click" Tag="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} up}">
                                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0"/><TextBlock Text="Move up" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource SoftButton}" Height="32" Padding="12,0" Margin="0,0,8,0" Click="PluginDown_Click" Tag="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} down}">
                                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0"/><TextBlock Text="Move down" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource SoftButton}" Height="32" Padding="12,0" Margin="0,0,8,0" Click="PluginReset_Click" Tag="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Reset {0} to defaults}">
                                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0"/><TextBlock Text="Reset to defaults" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource SoftButton}" Height="32" Padding="12,0" Click="PluginRemove_Click" Tag="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}">
                                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Bad}" Margin="0,0,8,0"/><TextBlock Text="Remove" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Bad}" VerticalAlignment="Center"/></StackPanel>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Background="#1C1925" Padding="14,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="#CDBBDD" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock Style="{StaticResource Hint}" MaxWidth="700" TextWrapping="Wrap"
                                       Text="Settings you make in a plugin's window are saved and used on your mic. WaveFix copies each plugin to C:\Program Files\WaveFix\Plugins (Windows asks once), the only place its audio engine loads code from. 64-bit VST2 plugins (.dll) only."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Shortcuts ===== -->
            <ScrollViewer x:Name="PageShortcuts" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="32,26,32,26">
                <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
                    <TextBlock Text="Shortcuts" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Pick keys that work anywhere, even while you're in a game." Style="{StaticResource PageSubtitle}"/>

                    <ItemsControl x:Name="ShortcutList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource PrimarySoft}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Action.Glyph}" Style="{StaticResource Icon}" FontSize="18" Foreground="#E3D7EE" HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Action.Title}" Style="{StaticResource Label}" FontSize="15"/>
                                            <TextBlock Text="{Binding Action.Description}" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Warn}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Error}" FontSize="12.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource SoftButton}" MinWidth="170" Height="42" Padding="16,0" VerticalAlignment="Center"
                                                Click="ShortcutKey_Click" Tag="{Binding}" AutomationProperties.Name="{Binding Action.Title, StringFormat=Set shortcut for {0}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource SubText}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding KeyText}" FontWeight="SemiBold" FontSize="13.5"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Style="{StaticResource SoftButton}" Width="42" Height="42" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Click="ShortcutClear_Click" Tag="{Binding}" ToolTip="Remove shortcut"
                                                Visibility="{Binding HasKey, Converter={StaticResource BoolToVis}}"
                                                AutomationProperties.Name="{Binding Action.Title, StringFormat=Remove shortcut for {0}}">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border CornerRadius="12" Background="#1C1925" Padding="14,12" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE82F;" Style="{StaticResource Icon}" Foreground="#CDBBDD" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock Style="{StaticResource Hint}" MaxWidth="700"
                                       Text="Tip: combine a key with Ctrl, Alt or Shift so it doesn't get in the way of typing. F-keys and numpad keys (Num 1, Num Plus...) also work on their own; numpad keys need Num Lock on. While setting a shortcut, Esc cancels and Backspace removes it."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
