<Window x:Class="WaveFix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaveFix" Width="1120" Height="680" MinWidth="900" MinHeight="560"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="WaveFix" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="  mic effects that stay out of your stream" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="StartupSwitch" Content="Start with Windows  " Style="{StaticResource Switch}" Margin="0" FontSize="13"
                          Checked="StartupSwitch_Changed" Unchecked="StartupSwitch_Changed"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Mic -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="MICROPHONE" Style="{StaticResource CardTitle}"/>
                    <ComboBox x:Name="MicPicker" ItemsSource="{Binding Mic.Devices}" SelectedItem="{Binding Mic.Selected}" Margin="0,0,0,10"/>

                    <Border x:Name="StatusBox" CornerRadius="8" Padding="10,8" Margin="0,0,0,16" Background="#22302A">
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12.5"/>
                    </Border>

                    <TextBlock Text="Level" Style="{StaticResource Label}"/>
                    <Border Height="14" CornerRadius="7" Background="#2A2E37" ClipToBounds="True" Margin="0,0,0,4">
                        <Grid x:Name="MeterHost">
                            <Border x:Name="MeterFill" HorizontalAlignment="Left" CornerRadius="7" Width="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#3DDC97" Offset="0"/>
                                        <GradientStop Color="#3DDC97" Offset="0.7"/>
                                        <GradientStop Color="#FFB547" Offset="0.88"/>
                                        <GradientStop Color="#FF5C6C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="Moves while an app (Discord, OBS…) is using the mic." FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>

                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding Mic.Gain, StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="13"/>
                        <TextBlock Text="Input level" Style="{StaticResource Label}" Margin="0"/>
                    </DockPanel>
                    <Slider Minimum="0" Maximum="100" Value="{Binding Mic.Gain}" Margin="0,0,0,18"/>

                    <ToggleButton Style="{StaticResource MuteButton}" IsChecked="{Binding Mic.Muted}" Height="44">
                        <TextBlock x:Name="MuteLabel" Text="Mute mic" FontSize="14" FontWeight="SemiBold"/>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <!-- Effects -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="EFFECTS" Style="{StaticResource CardTitle}"/>
                    <CheckBox x:Name="NoiseSwitch" Content="Noise removal" Style="{StaticResource Switch}" Checked="Effect_Changed" Unchecked="Effect_Changed"/>
                    <TextBlock Text="AI noise removal and gate (RNNoise). Removes keyboard, fans and room noise between words." TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,-6,0,16"/>

                    <CheckBox x:Name="LowCutSwitch" Content="Low cut (80 Hz)" Style="{StaticResource Switch}" Checked="Effect_Changed" Unchecked="Effect_Changed"/>
                    <TextBlock Text="Cuts desk thumps and rumble." FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,-6,0,18"/>

                    <TextBlock Text="Voice tone" Style="{StaticResource Label}"/>
                    <WrapPanel x:Name="PresetPanel" Margin="0,0,0,14"/>

                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="BoostValue" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="13"/>
                        <TextBlock Text="Voice boost" Style="{StaticResource Label}" Margin="0"/>
                    </DockPanel>
                    <Slider x:Name="BoostSlider" Minimum="-6" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Boost_Changed"/>
                    <TextBlock Text="Effects run inside Windows' audio engine, so Discord's stream can't record them." TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>

            <!-- Mixer -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="RoutingNote" DockPanel.Dock="Right" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                        <TextBlock Text="APP MIXER" Style="{StaticResource CardTitle}"/>
                    </DockPanel>
                    <TextBlock x:Name="EmptyMixer" DockPanel.Dock="Top" Text="No apps are playing sound right now." Foreground="{StaticResource Muted}" FontSize="13" Visibility="Collapsed"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Mixer.Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#22262E" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" CornerRadius="13" Background="#2F3540" VerticalAlignment="Top" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="44"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Minimum="0" Maximum="100" Value="{Binding Volume}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Volume, StringFormat={}{0:0}%}" Foreground="#8A90A0" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding Output}" Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="2" Style="{StaticResource MuteButton}" IsChecked="{Binding Muted}" Margin="12,0,0,0" VerticalAlignment="Top" Width="64">
                                                <TextBlock Text="Mute" FontSize="12.5"/>
                                            </ToggleButton>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
