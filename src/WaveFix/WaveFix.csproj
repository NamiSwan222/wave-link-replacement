<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyTitle>WaveFix</AssemblyTitle>
    <Product>WaveFix</Product>
    <Version>0.8.0</Version>
    <ApplicationIcon>Assets\WaveFix.ico</ApplicationIcon>
    <Company>NamiSwan222</Company>
    <Description>Wave Link replacement: mic effects that stay out of Discord streams</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- VST2 hosting calls plugin function pointers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WinForms analyzer: DPI is set in app.manifest on purpose (this is a WPF app) -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plus Jakarta Sans (SIL Open Font License, see Fonts/OFL.txt) -->
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\WaveFix.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its types out of global usings -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!--
    WaveFix's own effects plugin (voice polish + voice changer), a VST2 written in Rust in
    native/wavefix-fx. It's built here and embedded in the exe. Without Rust (cargo) the app still
    builds, minus those effects; release builds pass -p:RequireVoiceFx=true so that can't slip out.
  -->
  <PropertyGroup>
    <VoiceFxDir>$(MSBuildThisFileDirectory)..\..\native\wavefix-fx\</VoiceFxDir>
    <VoiceFxDll>$(VoiceFxDir)target\release\wavefix_fx.dll</VoiceFxDll>
  </PropertyGroup>
  <Target Name="BuildVoiceFx" BeforeTargets="BeforeBuild" Condition="'$(SkipVoiceFx)' != 'true'">
    <Exec Command="cargo build --release --quiet --manifest-path &quot;$(VoiceFxDir)Cargo.toml&quot;" ContinueOnError="WarnAndContinue" />
    <Error Condition="'$(RequireVoiceFx)' == 'true' And !Exists('$(VoiceFxDll)')" Text="The voice effects plugin didn't build (needs Rust: https://rustup.rs)." />
    <Warning Condition="!Exists('$(VoiceFxDll)')" Text="Building without the voice effects plugin (install Rust from https://rustup.rs to include it)." />
    <ItemGroup Condition="Exists('$(VoiceFxDll)')">
      <EmbeddedResource Include="$(VoiceFxDll)" LogicalName="WaveFix.VoiceFx.dll" />
    </ItemGroup>
  </Target>

  <!--
    WaveFix's own audio engine (native/wavefix-engine, Rust): the Windows audio effect new installs
    use instead of Equalizer APO. Built and embedded like the effects plugin above.
  -->
  <PropertyGroup>
    <EngineDir>$(MSBuildThisFileDirectory)..\..\native\wavefix-engine\</EngineDir>
    <EngineDll>$(EngineDir)target\release\wavefix_engine.dll</EngineDll>
  </PropertyGroup>
  <Target Name="BuildEngine" BeforeTargets="BeforeBuild" DependsOnTargets="BuildVoiceFx" Condition="'$(SkipVoiceFx)' != 'true'">
    <Exec Command="cargo build --release --quiet --manifest-path &quot;$(EngineDir)Cargo.toml&quot;" ContinueOnError="WarnAndContinue" />
    <Error Condition="'$(RequireVoiceFx)' == 'true' And !Exists('$(EngineDll)')" Text="The WaveFix audio engine didn't build (needs Rust: https://rustup.rs)." />
    <Warning Condition="!Exists('$(EngineDll)')" Text="Building without the WaveFix audio engine (new installs will fall back to Equalizer APO)." />
    <ItemGroup Condition="Exists('$(EngineDll)')">
      <EmbeddedResource Include="$(EngineDll)" LogicalName="WaveFix.Engine.dll" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

</Project>
