<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyTitle>WaveFix</AssemblyTitle>
    <Product>WaveFix</Product>
    <Version>0.8.6</Version>
    <ApplicationIcon>Assets\WaveFix.ico</ApplicationIcon>
    <Company>NamiSwan222</Company>
    <Description>Wave Link replacement: mic effects that stay out of Discord streams</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- VST2 hosting calls plugin function pointers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WinForms analyzer: DPI is set in app.manifest on purpose (this is a WPF app) -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plus Jakarta Sans (SIL Open Font License, see Fonts/OFL.txt) -->
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\WaveFix.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its types out of global usings -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!--
    WaveFix's own audio engine (native/wavefix-engine, Rust, with WaveFix's effects from
    native/wavefix-fx built in): the Windows audio effect that runs the mic chain. Built here and
    embedded in the exe. Without Rust (cargo) the app still builds, minus the engine; release builds
    pass -p:RequireEngine=true so that can't slip out.
  -->
  <PropertyGroup>
    <EngineDir>$(MSBuildThisFileDirectory)..\..\native\wavefix-engine\</EngineDir>
    <EngineDll>$(EngineDir)target\release\wavefix_engine.dll</EngineDll>
  </PropertyGroup>
  <Target Name="BuildEngine" BeforeTargets="BeforeBuild" Condition="'$(SkipEngine)' != 'true'">
    <Exec Command="cargo build --release --quiet --manifest-path &quot;$(EngineDir)Cargo.toml&quot;" ContinueOnError="WarnAndContinue" />
    <Error Condition="'$(RequireEngine)' == 'true' And !Exists('$(EngineDll)')" Text="The WaveFix audio engine didn't build (needs Rust: https://rustup.rs)." />
    <Warning Condition="!Exists('$(EngineDll)')" Text="Building without the WaveFix audio engine (install Rust from https://rustup.rs to include it)." />
    <ItemGroup Condition="Exists('$(EngineDll)')">
      <EmbeddedResource Include="$(EngineDll)" LogicalName="WaveFix.Engine.dll" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

</Project>
